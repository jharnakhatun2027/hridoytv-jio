    <div class="container mx-auto flex-grow">
<div
  id="portexe-search-root"
    class="relative z-50 w-full p-3 grid grid-cols-1 gap-2 sm:grid-cols-5 items-center justify-between glass-panel backdrop-blur-md border border-base-300/50 rounded-2xl shadow-sm"
  >
    <input
      id="portexe-search-input"
      type="text"
      placeholder="Search channels here"
      class="input input-bordered input-md w-full col-span-3 sm:col-span-1 text-base"
    />
    <select
      id="portexe-quality-select"
      class="select select-bordered select-sm sm:select-md w-full sm:max-w-xs sm:w-auto text-base sm:text-sm"
      onchange="onQualityChange(this)"
    >
      
      <option value="auto">Quality (Auto)</option>
      
      <option value="high">High</option>
      
      <option value="low">Low</option>
      
      <option value="medium">Medium</option>
      
    </select>
    <div class="dropdown dropdown-bottom w-full sm:w-auto" id="portexe-category-dropdown">
